# Development Environment Configuration
NODE_ENV=dev
PORT=3000

# MongoDB - Master Database (Platform Level)
MONGODB_URI=mongodb://localhost:27017/school-platform-dev

# JWT Configuration
JWT_SECRET=dev-secret-change-in-production-min-32-chars-long!!
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production!!
JWT_REFRESH_EXPIRES_IN=30d

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:8100

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Logging
LOG_LEVEL=debug

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Email (optional for dev)
# SMTP_HOST=smtp.mailtrap.io
# SMTP_PORT=587
# SMTP_USER=your_user
# SMTP_PASS=your_pass
# SMTP_FROM=noreply@schoolsystem.dev
