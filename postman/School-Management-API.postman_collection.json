{
  "info": {
    "name": "School Management System API",
    "description": "Complete enterprise-level multi-tenant school management platform API.\n\nThis collection provides a full end-to-end test flow:\n1. Register a school (creates school + admin user)\n2. Login as school admin\n3. Create teachers\n4. Create subjects\n5. Create classes (with class teacher assignment)\n6. Create parents\n7. Create students\n8. Link parents to students\n9. Test all CRUD operations\n\nRun requests in order for proper flow testing.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "2.0.0"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api/v1" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "schoolId", "value": "" },
    { "key": "schoolCode", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "teacherId", "value": "" },
    { "key": "teacher2Id", "value": "" },
    { "key": "subjectId", "value": "" },
    { "key": "subject2Id", "value": "" },
    { "key": "classId", "value": "" },
    { "key": "class2Id", "value": "" },
    { "key": "studentId", "value": "" },
    { "key": "student2Id", "value": "" },
    { "key": "parentId", "value": "" },
    { "key": "parent2Id", "value": "" },
    { "key": "academicYearId", "value": "" },
    { "key": "examId", "value": "" },
    { "key": "feeId", "value": "" },
    { "key": "attendanceId", "value": "" },
    { "key": "resultId", "value": "" },
    { "key": "timetableId", "value": "" },
    { "key": "notificationId", "value": "" },
    { "key": "subscriptionId", "value": "" },
    { "key": "promotionId", "value": "" },
    { "key": "transportId", "value": "" },
    { "key": "transferId", "value": "" },
    { "key": "settingsId", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}" }]
  },
  "item": [
    {
      "name": "1. Auth & School Setup",
      "description": "Register school and get authenticated",
      "item": [
        {
          "name": "1.1 Register School (Self-Service)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data) {",
                  "  const data = res.data;",
                  "  if (data.accessToken) pm.collectionVariables.set('accessToken', data.accessToken);",
                  "  if (data.refreshToken) pm.collectionVariables.set('refreshToken', data.refreshToken);",
                  "  if (data.school) {",
                  "    pm.collectionVariables.set('schoolId', data.school.id);",
                  "    pm.collectionVariables.set('schoolCode', data.school.code);",
                  "  }",
                  "  if (data.user) pm.collectionVariables.set('userId', data.user.id);",
                  "} else {",
                  "  if (res.accessToken) pm.collectionVariables.set('accessToken', res.accessToken);",
                  "  if (res.refreshToken) pm.collectionVariables.set('refreshToken', res.refreshToken);",
                  "  if (res.school) {",
                  "    pm.collectionVariables.set('schoolId', res.school.id);",
                  "    pm.collectionVariables.set('schoolCode', res.school.code);",
                  "  }",
                  "  if (res.user) pm.collectionVariables.set('userId', res.user.id);",
                  "}",
                  "pm.test('School registered successfully', function() {",
                  "  pm.response.to.have.status(201);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/register-school",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Rajesh\",\n  \"lastName\": \"Kumar\",\n  \"email\": \"rajesh.kumar@greenvalley.edu\",\n  \"password\": \"Admin@123456\",\n  \"schoolName\": \"Green Valley International School\",\n  \"phoneNumber\": \"+919876543210\",\n  \"schoolAddress\": \"123 Education Lane, Bangalore, Karnataka 560001\",\n  \"schoolEmail\": \"info@greenvalley.edu\",\n  \"schoolPhone\": \"+918012345678\"\n}"
            },
            "auth": { "type": "noauth" }
          }
        },
        {
          "name": "1.2 Login as School Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "const data = res.data || res;",
                  "if (data.accessToken) pm.collectionVariables.set('accessToken', data.accessToken);",
                  "if (data.refreshToken) pm.collectionVariables.set('refreshToken', data.refreshToken);",
                  "if (data.user) {",
                  "  pm.collectionVariables.set('userId', data.user.id);",
                  "  if (data.user.school) {",
                  "    pm.collectionVariables.set('schoolId', data.user.school.id);",
                  "    pm.collectionVariables.set('schoolCode', data.user.school.code);",
                  "  }",
                  "}",
                  "pm.test('Login successful', function() {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"rajesh.kumar@greenvalley.edu\",\n  \"password\": \"Admin@123456\"\n}"
            },
            "auth": { "type": "noauth" }
          }
        },
        {
          "name": "1.3 Get Profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Profile retrieved', function() {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/profile"
          }
        },
        {
          "name": "1.4 Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "const data = res.data || res;",
                  "if (data.accessToken) pm.collectionVariables.set('accessToken', data.accessToken);",
                  "pm.test('Token refreshed', function() {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/refresh-token",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "auth": { "type": "noauth" }
          }
        }
      ]
    },
